DATA_ROOT=KNOWLEDGE_NEXUS_LATAM_DATA_V1_RC2_PARTICIPANTS

# El modelo de embeddings en español (ONNX, local) vive en data/modelo_espanol/
# y no requiere configuración: ver scripts/exportar_modelo_espanol.py.

# Capa narrativa opcional (requiere instalar requirements-opcional.txt).
# El sistema funciona completo con LLM_HABILITADO=false.
LLM_HABILITADO=false
LLM_API_KEY=

# Asistente conversacional (pestaña "Asistente"), vía OpenRouter.
# Sin esta key, la pestaña sigue funcionando con narración de respaldo
# (sin IA, pero con los mismos datos reales). Conseguí una gratis en
# https://openrouter.ai/keys (sin tarjeta).
OPENROUTER_API_KEY=
